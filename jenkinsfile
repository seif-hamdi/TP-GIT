pipeline {
    agent any
    tools {
        jdk 'JDK21'
    }
    stages {
        stage('Checkout code') {
            steps {
                git branch: 'master', url: 'https://github.com/seif-hamdi/TP-GIT.git'
            }
        }
        stage('Compile code') {
            steps {
                sh '''
                    cd src
                    javac application/test.java
                '''
            }
        }
        stage('Execute code') {
            steps {
                sh '''
                    cd src
                    java application.test
                '''
            }
        }
        stage('display message') {
            steps {
                echo 'Hello from github'
            }
        }
    }
}
